# --- vLLM (سرو مدل‌های فاین‌تیون‌شده‌ی خودتان) ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-needed

# --- OpenRouter (برای مدل داور) ---
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- GapGPT (برای مدل داور - جایگزین/بک‌آپ OpenRouter) ---
GAPGPT_API_KEY=your_gapgpt_key_here
GAPGPT_BASE_URL=https://api.gapgpt.app/v1

# --- Hugging Face (فقط برای تسک MMLU-lite / Khayyam Challenge) ---
# دیتاست raia-center/khayyam-challenge روی HF گیت‌شده است: باید فرم رضایت
# لایسنس CC-ND را در صفحه‌ی دیتاست امضا کرده باشید تا این توکن کار کند.
# این دیتا هرگز نباید در ریپو کامیت شود (نگاه کنید به data/local_only/ در .gitignore).
HF_TOKEN=your_huggingface_token_here
